*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env/

# Environment files (keep examples)
.env
backend/.env
frontend/.env
frontend/.env.local

# Node
node_modules/

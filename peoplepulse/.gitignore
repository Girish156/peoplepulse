*.db
*.sqlite3

# Large generated datasets (keep small fixtures)
data/generated/*.csv
data/generated/*.json
data/manifests/*.json
data/reports/*.json
data/reports/*.md

# Docker
.docker/

# Coverage
.coverage
htmlcov/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Secrets - NEVER commit
*.pem
*.key
secrets/


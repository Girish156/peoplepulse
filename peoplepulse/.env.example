# PeoplePulse Root Environment Configuration
# Copy this to .env and fill in values

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://peoplepulse:peoplepulse@localhost:5432/peoplepulse

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-256-bit-secret-in-production

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Data Generation ──────────────────────────────────────────
DATA_SEED=20261022
DATA_MODE=small

